<?xml version="1.0" encoding="utf-8"?>
<!-- Allow cleartext for home Jellyfin servers on LAN (http://192.168.x.x). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
